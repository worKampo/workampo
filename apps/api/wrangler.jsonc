{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The top level is local only: a deploy without --env must never reach a real Worker (ADR-0013).
  "name": "app-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  // Source maps go only to Sentry (ADR-0043).
  "upload_source_maps": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // The SPA of apps/web; only these paths reach the Worker (ADR-0073). Repeated in each env.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/l/*", "/__debug/error"]
  },
  // Daily at 03:00 UTC: deletes rate-limit counters whose window has ended.
  "triggers": { "crons": ["0 3 * * *"] },
  // The fake identity provider exists only in this local bundle; stg and prod compile it out and
  // scripts/build/no-fake-provider.mjs fails their build if it is there (ADR-0029).
  "define": { "__ALLOW_FAKE_IDENTITY__": "true" },
  // Local test values. In stg and prod the thresholds are Cloudflare secrets (AGENTS.md "No entra")
  // and IDENTITY_PROVIDER is absent, so the real provider is the only one there. Hence wrangler's
  // expected warning that these vars "exist at the top level, but not on env.stg.vars".
  "vars": {
    "ENVIRONMENT": "local",
    "IDENTITY_PROVIDER": "fake",
    "RATE_LIMIT_CODE_REQUESTS_PER_EMAIL": "10",
    "RATE_LIMIT_CODE_REQUESTS_PER_IP": "1000",
    "RATE_LIMIT_CODE_ATTEMPTS_PER_EMAIL": "10",
    "RATE_LIMIT_WINDOW_SECONDS": "600"
  },
  "d1_databases": [
    {
      "binding": "DB_GLOBAL",
      "database_name": "global-local",
      "database_id": "local-global",
      "migrations_dir": "../../packages/db/migrations/global"
    },
    {
      "binding": "DB_SHARD_1",
      "database_name": "shard-1-local",
      "database_id": "local-shard-1",
      "migrations_dir": "../../packages/db/migrations/shard"
    }
  ],
  "kv_namespaces": [{ "binding": "LANDINGS", "id": "local-landings" }],
  // Bindings and vars are not inherited: each environment repeats them.
  // IDs printed by scripts/cloudflare/provision.mjs (EU jurisdiction); they are not secrets (ADR-0045).
  "env": {
    "stg": {
      "name": "app-stg",
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/health", "/l/*", "/__debug/error"]
      },
      "define": { "__ALLOW_FAKE_IDENTITY__": "false" },
      "triggers": { "crons": ["0 3 * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "stg",
        "ENABLE_DEBUG_ERROR": "true",
        // Public identifier of the WorkOS staging environment; the API key is a secret.
        "WORKOS_CLIENT_ID": "client_01M81TN93VKET6PAFSK3B1QYZJ"
      },
      "kv_namespaces": [{ "binding": "LANDINGS", "id": "80961b47e3a54aadbe0eb4c99f1d33cc" }],
      "d1_databases": [
        {
          "binding": "DB_GLOBAL",
          "database_name": "global-stg",
          "database_id": "ad46c99f-d19a-4294-97c3-16c15216d8cd",
          "migrations_dir": "../../packages/db/migrations/global"
        },
        {
          "binding": "DB_SHARD_1",
          "database_name": "shard-1-stg",
          "database_id": "bd793fd5-ff0d-4646-a123-c29b06b95adf",
          "migrations_dir": "../../packages/db/migrations/shard"
        }
      ]
    },
    "prod": {
      // Without an explicit name Wrangler would call it app-prod; the production Worker is app.
      "name": "app",
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/health", "/l/*", "/__debug/error"]
      },
      "define": { "__ALLOW_FAKE_IDENTITY__": "false" },
      "triggers": { "crons": ["0 3 * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": { "ENVIRONMENT": "prod" },
      "kv_namespaces": [{ "binding": "LANDINGS", "id": "5a7de207c19c4283a40ca5e6183612b3" }],
      "d1_databases": [
        {
          "binding": "DB_GLOBAL",
          "database_name": "global-prod",
          "database_id": "e8fe587d-c9de-427b-ade8-18d7e5211946",
          "migrations_dir": "../../packages/db/migrations/global"
        },
        {
          "binding": "DB_SHARD_1",
          "database_name": "shard-1-prod",
          "database_id": "fe346f76-d75b-4c8b-808d-2122aa6bed20",
          "migrations_dir": "../../packages/db/migrations/shard"
        }
      ]
    }
  }
}
