{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs", ".claude/hooks/*.mjs", "e2e/support/*.ts"]
    },
    "packages/i18n": {
      "ignoreDependencies": ["i18next"]
    },
    "apps/web": {
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/api": {
      "ignoreDependencies": ["@workampo/web"]
    }
  }
}
