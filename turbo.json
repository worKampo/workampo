{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {},
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@workampo/web#e2e": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "@workampo/api#e2e": {
      "dependsOn": ["^build", "@workampo/web#e2e"],
      "cache": false
    }
  }
}
