{
  "name": "workampo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "turbo run typecheck lint test && biome check . && depcruise apps packages && knip && pnpm check:repo",
    "check:repo": "node scripts/project/check.mjs && node scripts/agents/check-paths.mjs && node --test \"scripts/**/*.test.mjs\"",
    "prepare": "git config core.hooksPath .git/hooks && lefthook install --force"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "dependency-cruiser": "18.7.2",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
