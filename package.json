{
  "name": "workampo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "turbo run typecheck lint test && biome check . && depcruise apps packages && knip && pnpm check:repo",
    "check:ci": "turbo run typecheck lint test --affected --cache-dir=.turbo/cache && biome check . && depcruise apps packages && knip && pnpm check:repo",
    "check:repo": "node scripts/project/check.mjs && node scripts/agents/check-paths.mjs && node scripts/i18n/check-keys.mjs && node --test \"scripts/**/*.test.mjs\"",
    "e2e": "turbo run e2e",
    "prepare": "node scripts/git/prepare.mjs && lefthook install --force",
    "deploy": "node scripts/deploy/deploy.mjs",
    "work": "node scripts/work/work.mjs",
    "plan:check": "node scripts/plan/check.mjs",
    "plan:sync": "node scripts/plan/sync.mjs",
    "specs:ids": "node scripts/specs/ids.mjs",
    "test:new": "node scripts/test-new/new.mjs",
    "debt": "node scripts/debt/debt.mjs",
    "check:pr": "node scripts/checks/pr.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:backfill": "node scripts/db/backfill.mjs",
    "db:migration:new": "node scripts/db/migration-new.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@sentry/cli": "3.8.2",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
